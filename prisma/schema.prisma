// Saawariya — Multi-Vendor Textile Marketplace
// Prisma schema. See docs/ERD.md for the diagram and docs/DATA_MODEL.md for rationale.
//
// PORTABILITY NOTE (deliberate, see docs/DATA_MODEL.md):
// The local datasource is SQLite so the project runs with zero database setup.
// The schema is written to stay Postgres-compatible for production:
//   - no native `enum` blocks   -> status fields are String, constrained in src/lib/constants.ts
//   - no scalar list fields     -> relations or JSON-encoded strings instead
//   - no Decimal                -> all money is Int, stored in PAISE (1 rupee = 100 paise)
// Switching to Postgres is a provider change here plus DATABASE_URL in .env. Nothing else.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// IDENTITY, ROLES & ACCESS CONTROL  (SRS §16, §17, §88, §172, §173)
// ---------------------------------------------------------------------------

model Role {
  code        String   @id // CUSTOMER, SELLER, WAREHOUSE, QC, LOGISTICS, FINANCE, SUPPORT, MARKETING, SUPER_ADMIN
  name        String
  description String
  isSystem    Boolean  @default(true) // system roles cannot be deleted from the admin UI
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  code        String   @id // e.g. "product.approve", "settlement.release"
  module      String // Catalogue, Orders, Finance, Marketing, Support, Operations, Platform
  description String

  roles RolePermission[]
}

model RolePermission {
  roleCode       String
  permissionCode String

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@index([roleCode])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  mobile       String?   @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  roleCode     String
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING
  emailVerified Boolean  @default(false)
  mobileVerified Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role          Role           @relation(fields: [roleCode], references: [code])
  customer      Customer?
  seller        Seller?
  addresses     Address[]
  notifications Notification[]
  auditLogs     AuditLog[]
  loginEvents   LoginEvent[]
  otpCodes      OtpCode[]

  reviews          Review[]
  ticketsRaised    SupportTicket[]  @relation("TicketRaisedBy")
  ticketsAssigned  SupportTicket[]  @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  qcInspections    QcInspection[]
  approvedProducts Product[]        @relation("ProductApprover")

  @@index([roleCode])
  @@index([status])
}

/// Login attempt history — SRS §90 (login history, failed login monitoring), §178.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

/// OTP verification for registration and login — SRS §21, §36, §37.
model OtpCode {
  id        String    @id @default(cuid())
  userId    String?
  target    String // email address or mobile number the code was sent to
  codeHash  String
  purpose   String // REGISTER | LOGIN | RESET_PASSWORD
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose])
}

// ---------------------------------------------------------------------------
// CUSTOMERS  (SRS §16.2, §16.3, §21, §38)
// ---------------------------------------------------------------------------

model Customer {
  id            String    @id @default(cuid())
  userId        String    @unique
  customerType  String    @default("RETAIL") // RETAIL | WHOLESALE  (SRS §14)
  gstNumber     String? // wholesale buyers only
  dateOfBirth   DateTime?
  preferredLang String    @default("en")
  createdAt     DateTime  @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  cartItems CartItem[]
  wishlist  WishlistItem[]

  @@index([customerType])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String   @default("Home")
  fullName     String
  mobile       String
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String
  pinCode      String
  country      String   @default("India")
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// SELLERS  (SRS §52-68, §74)
// ---------------------------------------------------------------------------

model Seller {
  id                 String    @id @default(cuid())
  userId             String    @unique
  businessName       String
  ownerName          String
  businessType       String // MANUFACTURER | WHOLESALER | DISTRIBUTOR | RETAILER
  gstNumber          String?
  panNumber          String?
  logoUrl            String?
  description        String?
  // Verification workflow — SRS §55
  verificationStatus String    @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED | SUSPENDED
  verificationNote   String? // reason for rejection / info requested
  verifiedAt         DateTime?
  // Business address & pickup — SRS §57
  addressLine        String?
  city               String?
  state              String?
  pinCode            String?
  pickupAddress      String?
  // Banking for settlements — SRS §57, §62
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  // Commission the platform charges this seller — SRS §13.1
  commissionPercent  Int       @default(10)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  subOrders   SubOrder[]
  settlements Settlement[]
  documents   SellerDocument[]

  @@index([verificationStatus])
}

/// KYC documents uploaded during seller onboarding — SRS §54, §55.
model SellerDocument {
  id         String    @id @default(cuid())
  sellerId   String
  docType    String // GST_CERTIFICATE | PAN_CARD | CANCELLED_CHEQUE | ADDRESS_PROOF
  fileUrl    String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote String?
  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// CATALOGUE  (SRS §58, §59, §76, §145, §157-159)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  iconName    String?
  parentId    String? // self-relation gives the Shop mega-menu hierarchy
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  slug        String  @unique
  description String
  sellerId    String
  categoryId  String
  brand       String?
  collection  String?

  // Textile attributes — SRS §58 "Textile Details", drives the listing facets in §157
  fabric      String?
  pattern     String?
  occasion    String?
  workType    String?
  color       String?
  weightGrams Int?

  // Pricing, in PAISE. Dual retail/wholesale per SRS §58, §14.
  priceRetail    Int
  priceWholesale Int?
  priceOffer     Int?
  /// (priceOffer ?? priceRetail), denormalised.
  ///
  /// The listing sorts and range-filters on the price a retail buyer actually
  /// pays. Prisma cannot order by a COALESCE expression, so without this column
  /// "sort by price" would either order by the pre-discount price (wrong for
  /// the 11 products carrying an offer) or have to sort in memory, which breaks
  /// pagination. Every write path must set it via effectiveRetailPaise() in
  /// src/lib/catalogue/pricing.ts — never by hand.
  priceEffective Int @default(0)
  // Minimum / maximum order quantity — enforces wholesale MOQ (SRS §58 "Inventory")
  minOrderQty Int @default(1)
  maxOrderQty Int @default(100)

  // Approval workflow — SRS §59, §75
  status          String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | HIDDEN
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?

  // Merchandising & derived stats
  isFeatured  Boolean @default(false)
  isNewArrival Boolean @default(false)
  salesCount  Int     @default(0)
  ratingAvg   Int     @default(0) // stored x10 (45 = 4.5) to stay integer-only
  ratingCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller     Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id])
  approvedBy User?            @relation("ProductApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  inventory  Inventory?
  reviews    Review[]
  cartItems  CartItem[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([priceEffective])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String @id @default(cuid())
  productId      String
  name           String // e.g. "Size", "Length"
  value          String // e.g. "5.5m", "Free Size"
  sku            String @unique
  priceDeltaPaise Int   @default(0)
  stockQty       Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// INVENTORY  (SRS §60, §77, §97, §98)
// ---------------------------------------------------------------------------

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  stockQty          Int      @default(0)
  reservedQty       Int      @default(0) // held by paid-but-not-yet-dispatched orders
  lowStockThreshold Int      @default(5)
  status            String   @default("IN_STOCK") // IN_STOCK | LOW_STOCK | OUT_OF_STOCK | DISCONTINUED
  updatedAt         DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]
}

/// Append-only stock ledger — SRS §97 "update stock movement".
model StockMovement {
  id          String   @id @default(cuid())
  inventoryId String
  changeQty   Int // positive = inward, negative = outward
  reason      String // SELLER_RESTOCK | ORDER_RESERVED | ORDER_DISPATCHED | ORDER_CANCELLED | QC_DAMAGED | RETURN_RESTOCK | ADJUSTMENT
  referenceId String? // order / suborder id where applicable
  note        String?
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
}

// ---------------------------------------------------------------------------
// CART & WISHLIST  (SRS §41, §42)
// ---------------------------------------------------------------------------

model CartItem {
  id         String @id @default(cuid())
  customerId String
  productId  String
  /// Empty string — NOT null — when the product has no variants.
  ///
  /// The @@unique below is what stops "add to bag" twice creating two rows for
  /// the same thing. In SQL, NULL is never equal to NULL, so a nullable column
  /// here would exempt every variant-less product from that constraint —
  /// silently, and for most of the catalogue. Prisma also cannot address a NULL
  /// member of a compound unique key, so upsert would be impossible.
  /// Readers normalise "" back to null; see src/lib/commerce/cart.ts.
  variantId String   @default("")
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, variantId])
  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  addedAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// ORDERS
//
// MULTI-SELLER MODEL (the SRS does not specify this — see docs/DATA_MODEL.md):
// One Order  = what the customer places and pays for, once.
// One SubOrder = the fulfilment unit for ONE seller. The warehouse/QC/logistics
// pipeline and the seller settlement both operate on SubOrder, never on Order.
// A cart spanning three sellers becomes 1 Order + 3 SubOrders + 1 Payment.
// ---------------------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // SAAW-2026-000123
  customerId  String

  status String @default("PENDING") // PENDING | CONFIRMED | PROCESSING | PARTIALLY_SHIPPED | SHIPPED | DELIVERED | CANCELLED | RETURNED

  // Money, in PAISE
  subtotal       Int
  discountAmount Int @default(0)
  shippingAmount Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  couponCode String?

  // Address snapshots — orders must not change when the customer edits their address book
  shipShippingName  String
  shipMobile        String
  shipLine1         String
  shipLine2         String?
  shipCity          String
  shipState         String
  shipPinCode       String
  shipCountry       String  @default("India")
  billingSameAsShip Boolean @default(true)
  billingJson       String? // JSON blob when billing differs

  placedAt    DateTime  @default(now())
  cancelledAt DateTime?
  cancelReason String?
  updatedAt   DateTime  @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  subOrders SubOrder[]
  payments  Payment[]
  events    OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
}

/// Per-seller fulfilment unit. Carries the warehouse -> QC -> pack -> ship pipeline.
/// Status values and legal transitions live in src/lib/order-state-machine.ts (SRS §92-110).
model SubOrder {
  id             String @id @default(cuid())
  subOrderNumber String @unique // SAAW-2026-000123-A
  orderId        String
  sellerId       String

  status String @default("PLACED")
  // PLACED -> CONFIRMED -> WAREHOUSE_QUEUE -> PICKING -> PICKED -> QC_PENDING
  //   -> QC_PASSED -> PACKING -> READY_FOR_DISPATCH -> DISPATCHED -> IN_TRANSIT
  //   -> OUT_FOR_DELIVERY -> DELIVERED
  // QC_FAILED -> RETURNED_TO_WAREHOUSE -> PICKING (reinspection loop)
  // CANCELLED / RETURN_REQUESTED / RETURNED terminate the flow

  /// Gross value of this seller's lines, BEFORE any order-level coupon.
  /// Seller commission (SRS §119) is charged on this figure, so a platform
  /// promotion does not quietly come out of the seller's payout.
  subtotal Int
  /// This sub-order's share of the order-level coupon discount, apportioned by
  /// value with largest-remainder rounding (src/lib/commerce/totals.ts).
  ///
  /// The column exists so the sub-orders reconcile exactly:
  ///   SUM(subtotal - discountAmount + shippingAmount) === Order.totalAmount
  /// Without it a discounted multi-seller order silently fails to add up, which
  /// is the one thing an integer-paise money model is supposed to prevent.
  discountAmount Int @default(0)
  shippingAmount Int @default(0)
  totalAmount    Int

  // Denormalised pipeline timestamps — power the operations dashboards (SRS §94, §100, §113)
  confirmedAt  DateTime?
  pickedAt     DateTime?
  qcAt         DateTime?
  packedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        Seller         @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  shipment      Shipment?
  qcInspections QcInspection[]
  settlement    Settlement?
  returnRequest ReturnRequest?
  events        OrderEvent[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(cuid())
  subOrderId String
  productId  String
  variantId  String?

  // Snapshots — the line must survive the product being edited or delisted
  productName String
  productSku  String
  imageUrl    String?
  unitPrice   Int // PAISE, the price actually charged (retail or wholesale)
  priceTier   String @default("RETAIL") // RETAIL | WHOLESALE
  quantity    Int
  lineTotal   Int

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([subOrderId])
  @@index([productId])
}

/// Append-only audit trail of every pipeline transition — feeds customer order
/// tracking (SRS §46) and the operations reports (SRS §113).
model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String?
  subOrderId  String?
  fromStatus  String?
  toStatus    String
  actorUserId String?
  actorRole   String
  note        String?
  createdAt   DateTime @default(now())

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder SubOrder? @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([subOrderId])
}

// ---------------------------------------------------------------------------
// OPERATIONS: QC, SHIPPING, RETURNS  (SRS §99-111)
// ---------------------------------------------------------------------------

/// SRS §102 checklist + §104 rejection reasons.
model QcInspection {
  id          String @id @default(cuid())
  subOrderId  String
  inspectorId String

  result String // PASSED | FAILED
  // Checklist groups from SRS §102, stored as JSON so the checklist can evolve
  // without a migration: { product: {...}, fabric: {...}, appearance: {...}, quantity: {...}, packaging: {...} }
  checklistJson   String
  rejectionReason String? // WRONG_PRODUCT | WRONG_VARIANT | FABRIC_DAMAGE | COLOR_MISMATCH | PACKAGING_ISSUE | MISSING_ITEM | LABEL_ISSUE | QUANTITY_MISMATCH
  notes           String?
  isReinspection  Boolean @default(false)
  createdAt       DateTime @default(now())

  subOrder  SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  inspector User     @relation(fields: [inspectorId], references: [id])

  @@index([subOrderId])
  @@index([result])
}

/// SRS §107-109.
model Shipment {
  id         String @id @default(cuid())
  subOrderId String @unique

  courierName    String
  trackingNumber String  @unique
  status         String  @default("AWAITING_PICKUP") // AWAITING_PICKUP | PICKED_UP | IN_TRANSIT | REACHED_HUB | OUT_FOR_DELIVERY | DELIVERED | DELIVERY_FAILED | RETURNED_TO_ORIGIN
  invoiceUrl     String?
  labelUrl       String?

  dispatchedAt DateTime?
  deliveredAt  DateTime?
  failureReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subOrder SubOrder           @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  events   ShipmentEvent[]
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

/// SRS §111 — conditional on platform policy, modelled but gated by a Setting.
model ReturnRequest {
  id         String @id @default(cuid())
  subOrderId String @unique

  reason     String
  detail     String?
  status     String  @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | PICKUP_SCHEDULED | RECEIVED | INSPECTED | REFUNDED | REPLACED
  resolution String? // REFUND | REPLACEMENT
  reviewNote String?

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// FINANCE  (SRS §116-122)
// ---------------------------------------------------------------------------

model Payment {
  id      String @id @default(cuid())
  orderId String

  method       String // UPI | CREDIT_CARD | DEBIT_CARD | NET_BANKING | WALLET | COD
  amount       Int // PAISE
  status       String @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED | REFUNDED
  gatewayRef   String? @unique
  failureReason String?
  // Idempotency key — a retried gateway callback must never double-credit an order
  idempotencyKey String? @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

model Refund {
  id        String @id @default(cuid())
  paymentId String

  amount     Int // PAISE
  reason     String // ORDER_CANCELLED | DELIVERY_FAILED | PRODUCT_ISSUE | PAYMENT_ERROR | RETURN
  status     String @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED | PROCESSED
  reviewNote String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

/// Seller payout for one delivered SubOrder — SRS §119, §120.
/// net = gross - commission. All PAISE, all integer, so totals always reconcile.
model Settlement {
  id         String @id @default(cuid())
  sellerId   String
  subOrderId String @unique

  grossAmount       Int
  commissionPercent Int
  commissionAmount  Int
  netAmount         Int

  status     String @default("PENDING") // PENDING | UNDER_REVIEW | RELEASED | FAILED
  reference  String?
  note       String?

  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  seller   Seller   @relation(fields: [sellerId], references: [id])
  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// MARKETING & CMS  (SRS §82-85, §123-129)
// ---------------------------------------------------------------------------

model Coupon {
  id   String @id @default(cuid())
  code String @unique

  discountType    String // PERCENTAGE | FIXED | FREE_SHIPPING
  discountValue   Int // percent (0-100) or PAISE depending on discountType
  minOrderValue   Int     @default(0)
  maxDiscount     Int? // cap for percentage coupons, PAISE
  usageLimit      Int? // total redemptions allowed
  usageCount      Int     @default(0)
  perCustomerLimit Int    @default(1)
  eligibility     String  @default("ALL") // ALL | NEW_CUSTOMERS | RETURNING | WHOLESALE
  isActive        Boolean @default(true)

  startsAt DateTime
  endsAt   DateTime
  createdAt DateTime @default(now())

  @@index([isActive])
}

model Banner {
  id       String @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String
  linkUrl  String?
  position String @default("HOME_HERO") // HOME_HERO | HOME_STRIP | CATEGORY_TOP | PROMO
  sortOrder Int   @default(0)
  isActive Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?
  createdAt DateTime @default(now())

  @@index([position, isActive])
}

model Campaign {
  id       String @id @default(cuid())
  name     String
  description String?
  bannerUrl String?
  offerDetail String?
  audience String @default("ALL") // ALL | NEW_CUSTOMERS | RETURNING | WHOLESALE | SEGMENT
  status   String @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | COMPLETED | CANCELLED

  // Performance counters — SRS §129
  viewCount       Int @default(0)
  clickCount      Int @default(0)
  conversionCount Int @default(0)

  startsAt DateTime
  endsAt   DateTime
  createdAt DateTime @default(now())

  @@index([status])
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique // about-us, privacy-policy, terms, faq, shipping-policy, return-policy
  title     String
  bodyHtml  String
  metaTitle String?
  metaDescription String?
  isPublished Boolean @default(true)
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  subscribedAt DateTime  @default(now())
  unsubscribedAt DateTime?
}

// ---------------------------------------------------------------------------
// ENGAGEMENT: REVIEWS, NOTIFICATIONS, SUPPORT  (SRS §47, §48, §130-140)
// ---------------------------------------------------------------------------

model Review {
  id        String @id @default(cuid())
  productId String
  userId    String

  rating     Int // 1-5
  title      String?
  body       String
  imagesJson String? // JSON array of uploaded image URLs
  status     String  @default("PENDING") // PENDING | APPROVED | REJECTED — moderated per SRS §47
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([status])
}

model Notification {
  id     String @id @default(cuid())
  userId String

  title    String
  body     String
  category String // ORDER | PAYMENT | SHIPMENT | PRODUCT | SETTLEMENT | PROMOTION | SYSTEM | SUPPORT
  linkUrl  String?
  channel  String  @default("IN_APP") // IN_APP | EMAIL | SMS | PUSH | WHATSAPP
  isRead   Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique // TKT-2026-00042

  raisedById String
  assigneeId String?

  category String // ORDER_ISSUE | DELIVERY_ISSUE | PAYMENT_ISSUE | PRODUCT_ISSUE | RETURN_REQUEST | REFUND_REQUEST | TECHNICAL | ACCOUNT | PRODUCT_APPROVAL | SETTLEMENT | GENERAL
  priority String @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  /// Numeric mirror of `priority`, so the helpdesk queue can sort by importance.
  /// `priority` is a String for Postgres portability (see the note at the top of
  /// this file) and Prisma cannot orderBy a CASE expression, so sorting the
  /// column itself is alphabetical: CRITICAL, HIGH, LOW, MEDIUM — which puts
  /// MEDIUM above HIGH and LOW above both. Sorting in memory instead would
  /// break pagination. Same problem and same fix as `Product.priceEffective`
  /// in Phase 3. Every write path must set it via `ticketPriorityRank()`.
  priorityRank Int @default(2)
  status   String @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | WAITING_CUSTOMER | RESOLVED | CLOSED

  subject         String
  description     String
  relatedOrderId  String?
  resolutionNote  String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  closedAt   DateTime?

  raisedBy User            @relation("TicketRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status])
  @@index([assigneeId])
  @@index([priorityRank])
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  authorId String

  body String
  /// SRS §137 — internal notes are visible only to authorised staff, never to the requester.
  isInternalNote Boolean @default(false)
  createdAt      DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// PLATFORM: SETTINGS & AUDIT  (SRS §87, §89)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id // e.g. platform.currency, feature.returns_enabled, feature.cod_enabled
  value     String
  category  String // GENERAL | BRANDING | CURRENCY | TAX | SHIPPING | PAYMENT | EMAIL | NOTIFICATION | SEO
  label     String
  valueType String   @default("STRING") // STRING | NUMBER | BOOLEAN | JSON
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// SRS §89 — who changed what, when. Written by the mutation helpers, never by hand.
model AuditLog {
  id     String @id @default(cuid())
  userId String?

  action     String // SELLER_APPROVED | PRODUCT_APPROVED | ORDER_STATUS_CHANGED | SETTINGS_CHANGED | ...
  entityType String
  entityId   String
  summary    String
  metaJson   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
