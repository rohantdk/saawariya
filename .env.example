# ---------------------------------------------------------------------------
# Saawariya — environment configuration
#
# `npm run setup` copies this file to `.env` automatically if one is not present.
# Nothing here needs editing to run the project locally.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Default is SQLite: a single file, no database server to install.
# The path is resolved relative to prisma.config.ts (the project root).
DATABASE_URL="file:./dev.db"

# To run against PostgreSQL instead, change the `provider` in
# prisma/schema.prisma to "postgresql" and set a connection string here:
# DATABASE_URL="postgresql://user:password@localhost:5432/saawariya?schema=public"

# Session -------------------------------------------------------------------
# Signs the session JWT. Any long random string works for local use.
# Generate a fresh one for production:  openssl rand -base64 32
SESSION_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"

# Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Saawariya"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeding -------------------------------------------------------------------
# Shared password for every seeded demo account (see the credentials table in README.md).
SEED_DEMO_PASSWORD="Saawariya@123"

# Hosted demo ---------------------------------------------------------------
# Leave BOTH of these unset for local development — the site behaves exactly as
# it always has. They only apply to a deployed demo. See docs/DEPLOYMENT.md.
#
# Setting DEMO_PASSWORD puts HTTP Basic Auth in front of every page AND every
# image, and marks the site noindex. One shared password; the username is
# ignored. It keeps the build reviewable by the client without publishing it,
# which matters while the imagery in public/editorial/CREDITS.md is unresolved.
# DEMO_PASSWORD="pick-something-and-send-it-to-the-client"
#
# On a host, point DATABASE_URL at the mounted volume — an absolute path that
# survives a redeploy. A relative path lands inside the container and is thrown
# away with it; scripts/deploy-start.mjs refuses to boot rather than let that
# happen quietly.
# DATABASE_URL="file:/data/saawariya.db"
