# ---------------------------------------------------------------------------
# Saawariya — environment configuration
#
# `npm run setup` copies this file to `.env` automatically if one is not present.
# Nothing here needs editing to run the project locally.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Default is SQLite: a single file, no database server to install.
# The path is resolved relative to prisma.config.ts (the project root).
DATABASE_URL="file:./dev.db"

# To run against PostgreSQL instead, change the `provider` in
# prisma/schema.prisma to "postgresql" and set a connection string here:
# DATABASE_URL="postgresql://user:password@localhost:5432/saawariya?schema=public"

# Session -------------------------------------------------------------------
# Signs the session JWT. Any long random string works for local use.
# Generate a fresh one for production:  openssl rand -base64 32
SESSION_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"

# Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Saawariya"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeding -------------------------------------------------------------------
# Shared password for every seeded demo account (see the credentials table in README.md).
SEED_DEMO_PASSWORD="Saawariya@123"
